{
  "name": "dms-fitness-miniapp",
  "version": "0.2.7",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify:apps-script": "node apps-script/scripts/verify-snapshots.mjs",
    "preflight:client-pilot": "node apps-script/migrations/client-portal-v1/pilot-preflight.mjs",
    "preflight:client-enrollment": "node apps-script/migrations/client-portal-enrollment-v1/preflight.mjs",
    "smoke:apps-script-runtime": "node apps-script/scripts/check-runtime-identity.mjs",
    "smoke:miniapp-production": "node scripts/verify-production.mjs",
    "release:check": "npm run check",
    "release:verify": "node scripts/verify-production.mjs",
    "release:checkpoint": "node scripts/capture-release-checkpoint.mjs",
    "release:source-check": "node scripts/verify-source-state.mjs",
    "release:apps-script:plan": "node apps-script/scripts/release-plan.mjs",
    "release:apps-script:credential-check": "node apps-script/scripts/check-credential-profile.mjs",
    "release:backup:verify": "node apps-script/scripts/verify-backup-manifest.mjs",
    "release:migration:readiness": "node scripts/verify-migration-readiness.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "verify:dependency-policy": "node scripts/verify-dependency-policy.mjs",
    "verify:migrations": "node apps-script/scripts/verify-migrations.mjs",
    "verify:migration-history": "node apps-script/scripts/verify-ledger-history.mjs",
    "check:miniapp": "npm run lint && npm run test && npm run typecheck && npm run build",
    "check": "npm run verify:dependency-policy && npm run audit:dependencies && npm run check:miniapp && npm run verify:apps-script && npm run verify:migrations"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "typescript": "5.9.3"
  }
}
