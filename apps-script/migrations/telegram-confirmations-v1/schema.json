{
  "schemaVersion": 1,
  "sheet": {
    "name": "Журнал операций Telegram",
    "columns": [
      { "name": "Event ID", "type": "text", "required": true, "unique": true, "pattern": "^TGE-[A-Za-z0-9-]+$" },
      { "name": "At", "type": "datetime", "required": true },
      { "name": "Operation ID", "type": "text", "required": true, "pattern": "^TGOP-[a-f0-9]{24}$" },
      { "name": "Confirmation ID", "type": "text", "required": true, "pattern": "^[a-f0-9]{16}$" },
      { "name": "Event", "type": "enum", "required": true, "values": ["pending", "committed", "failed", "replay", "expired", "revoked"] },
      { "name": "Action", "type": "text", "required": true },
      { "name": "Admin Hash", "type": "text", "required": true, "pattern": "^[A-Za-z0-9_-]{43}$" },
      { "name": "Chat Hash", "type": "text", "required": true, "pattern": "^[A-Za-z0-9_-]{43}$" },
      { "name": "Message ID", "type": "text", "required": true },
      { "name": "Payload Hash", "type": "text", "required": true, "pattern": "^[A-Za-z0-9_-]{43}$" },
      { "name": "Result Code", "type": "text", "required": false },
      { "name": "Result Ref Hash", "type": "text", "required": false, "pattern": "^[A-Za-z0-9_-]{43}$" },
      { "name": "Detail", "type": "text", "required": false }
    ],
    "frozenRows": 1,
    "appendOnly": true
  },
  "invariants": [
    "plaintext nonces, Telegram identities, client data and financial payloads are never stored",
    "one confirmation maps to one operation ID",
    "a committed operation is never executed again",
    "ledger history is append-only"
  ]
}
